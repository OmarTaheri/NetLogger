{
  "name": "netlogger",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:collector && concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "npm run build:web && npm run build:api",
    "build:api": "tsc -p apps/api/tsconfig.json && npm run build:collector",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:collector": "node apps/api/src/tracking-collector/build.js",
    "test": "npm run test:api && npm run test:web",
    "test:api": "vitest run --config apps/api/vitest.config.ts",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "start": "node apps/api/dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.0"
  }
}
